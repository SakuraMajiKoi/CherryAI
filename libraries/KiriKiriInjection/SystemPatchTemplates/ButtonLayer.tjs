// �v���_�E�����j���[�g��
class WF_PullDownLayer extends WF_Layer
{
	var SelectBtn; // �I�𒆃{�^���̏�ɏ悹��摜
	var SelectBtnBG = void; // �I�𒆃{�^��

	var ListBG=void;
	var ListBGMask=void;
	var Slid=void;

	var BGLayer=void;
	var MenuLayerArray = new Array();
	var BGReleaseTA;

	var _backColor = 0x440033ff;
	var _LineColor = 0xFFFFFF;
	var _ItemMAX = 0;
	property backColor
	{
		setter(v){ _backColor=v; }
		getter(){ return _backColor; }
	}
	property LineColor
	{
		setter(v){ _LineColor=v; if( 0xFFFFFF < v){dminfo("0xFFFFFF�ȓ��Ŏw�肵�Ă�������");}}
		getter(){ return _LineColor; }
	}
	property itemMAX
	{
		setter(v){ _ItemMAX=v; }
		getter(){ return _ItemMAX; }
	}

	function finalaize()
	{
		release(SelectBtn);
		release(SelectBtnBG);

		release(ListBG);
		release(ListBGMask);
		release(BGLayer);
		release(MenuLayerArray);
		release(BGReleaseTA);
		release(Slid);
		super.finalaize();
	}

	function onRClickFuncSet(x)
	{
		SelectBtn.RClickFunc = x;
	}

	function WF_PullDownLayer(f_win,f_par,f_loadFile=void)
	{
		super.WF_Layer(f_win,f_par);
		visible=true;

		BGReleaseTA = new AsyncTrigger(_ReleseBG,'');
		BGReleaseTA.cached = false;
		BGReleaseTA.mode = atmExclusive;

		SelectBtn = new global.WF_ButtonLayer(window,this);
		with(SelectBtn)
		{
			if( f_loadFile !== void && f_loadFile != "" )
				.loadImages("pullbtn");

			.visible=true;
			.onMouseUpEx = function(x, y, button, shift)
			{
				onMouseUpEx2(...);
			}incontextof this;
			.onDrawState = function(s)
			{
				return;
				if( SelectBtnBG !== void )
				{
					if( SelectBtnBG.ImageFileName !== void ) // �摜����������
						SelectBtnBG.imageLeft = -s * SelectBtnBG.width;
					SelectBtnBG.hitThreshold = 256;
				}

			}incontextof this;
		}
		super.setSize(SelectBtn.width,SelectBtn.height);
	}

	// �����������琮���Ԗڃ��j���[��
	// �����񂾂�����l�[�����炻�̃��j���[��I��
	function SelectUpdate(No=0)
	{
		if( (typeof No) == 'String' )
		{
			for(var i=0; i < MenuLayerArray.count;i++)
			{
				if( MenuLayerArray[i].name == No )
				{
					No = i;
					break;
				}
			}
		}

		if( SelectBtnBG === void )
		{
			SelectBtnBG = new global.WF_ButtonLayer(window,this);
			with(SelectBtnBG)
			{
				.assignComp(MenuLayerArray[No]);
				.visible=true;
				.hitThreshold = 256;
				.onMouseUpEx = function(x, y, button, shift)
				{
					onMouseUpEx2(...);
				}incontextof this;
			}
		}
		else
		{
			SelectBtnBG.assignComp(MenuLayerArray[No]);
		}

		if( SelectBtn.ImageFileName !== void )
			SelectBtnBG.hitThreshold = 256;
		else
			SelectBtnBG.hitThreshold = 0;

		if( SelectBtn.ImageFileName === void )
		if( this.width < SelectBtnBG.width || this.height < SelectBtnBG.height )
		{
			SelectBtn.setSize(SelectBtnBG.width,SelectBtnBG.height);
			super.setSize(SelectBtn.width,SelectBtn.height);
		}
	}

	function _ReleseBG()
	{
		if( BGLayer !== void )
		{
			release(BGLayer);
			BGLayer = void;
			release(ListBG);
			ListBG = void;
			release(Slid);
			Slid = void;
			release(ListBGMask);
			ListBGMask = void;
		}
	}

	// �w�薼�̃��j���[�ɕ�����`��
	function drawTextSelectBtn(f_name,x,y,f_Text="",f_color=0xFFFFFF,f_size=17,f_centerY=true)
	{
		for(var i=0; i < MenuLayerArray.count;i++)
		{
			if( MenuLayerArray[i].name == f_name )
			{
				if( f_centerY ) MenuLayerArray[i].texttypeY = "center";
				MenuLayerArray[i].font.height = f_size;
				MenuLayerArray[i].drawTextEx(x,y,f_Text,f_color);
				break;
			}
		}
	}
	// ���j���[�A�C�e���ɑ΂��ĈꊇsetSize
	function setSizeMenuItem(w,h)
	{
		for(var i=0; i < MenuLayerArray.count;i++)
		{
			MenuLayerArray[i].setSize(w,h);
		}
	}

	function Clear()
	{
		release(MenuLayerArray);
		MenuLayerArray.clear();
	}

	function Erase(No=0)
	{
		if( (typeof No) == 'String' )
		{
			for(var i=0; i < MenuLayerArray.count;i++)
			{
				if( MenuLayerArray[i].name == No )
				{
					No = i;
					break;
				}
			}
		}

		MenuLayerArray.erase(No);
	}

	// ���j���[�{�^���쐬
	function Add(f_imageFile=void,f_name="")
	{
		var t = MenuLayerArray.add( new global.WF_ButtonLayer(window,this) );
		with(MenuLayerArray[t])
		{
			if( f_name === void || f_name == "" )	f_name = ""+t;
			.name = f_name;
			.visible=false;
			.No = t;
			.m_this = this;
			if( f_imageFile !== void && f_imageFile != "" )
				.loadImages(f_imageFile);
			.onMouseUpEx = function(x, y, button, shift)
			{
				if( m_this.BGLayer === void ) return;
				if( button == mbLeft )
				{
					m_this.SelectUpdate(No);
					m_this.onClickEvent(this,this.name);
				}
				m_this.BGLayer.onMouseUp(...);
			};
		}

		return MenuLayerArray[t];
	}

	// ���j���[���N���b�N���ꂽ���̃C�x���g
	function onClickEvent(layerPoint,name){}

	function onMouseUpEx2(x, y, button, shift)
	{
		BGLayer = new global.WF_Layer(window,parent);
		with(BGLayer)
		{
			.visible=true;
			.setSize();
			//.fullRect(0x6600FFFF);
			.hitThreshold = 0;
			.m_this = this;
			.onMouseUp = function(x, y, button, shift)
			{
				m_this.BGReleaseTA.trigger();
			};
		}

		ListBGMask = new global.WF_Layer(window,BGLayer);
		with(ListBGMask)
		{
			.visible=true;
			.hitThreshold = 256;
			.m_this = this;
			.setPos(this.left-1,this.top+this.height);
			.onMouseUp = function(x, y, button, shift)
			{
				m_this.BGReleaseTA.trigger();
			};
		}

		ListBG = new global.WF_Layer(window,ListBGMask);
		with(ListBG)
		{
			.visible=true;
			.hitThreshold = 0;
			.m_this = this;
			.setPos(0,0);
			.onMouseUp = function(x, y, button, shift)
			{
				m_this.BGReleaseTA.trigger();
			};
		}

		var arrya_height=1;
		for( var i=0; i < MenuLayerArray.count; i++ )
		{
			MenuLayerArray[i].parent=ListBG;
			MenuLayerArray[i].top = arrya_height;
			MenuLayerArray[i].left = 1;

			MenuLayerArray[i].visible=true;

			arrya_height += MenuLayerArray[i].height; // height���Z
		}

		ListBGMask.setSize(this.width+2,arrya_height);
		ListBG.setSize(this.width+2,arrya_height);
		ListBG.fullRect(backColor);

		var overItem=false;
		if( 0 < MenuLayerArray.count && 0 < itemMAX )
		{
			if( MenuLayerArray[0].height*itemMAX+1 < ListBGMask.height )
			{ // �A�C�e�����E�����Ă���
				ListBGMask.height = MenuLayerArray[0].height*itemMAX+1;
				overItem = true;
			}
		}

		DrawCircle(ListBG,3,LineColor);

		if( overItem )
		{
			Slid = new SliderLayer(window, ListBGMask, ListBGMask.height, "�c", "xx2_backlog_�X���C�_�[�܂�");
			with(Slid)
			{
				.setPos(ListBG.width-20, 0);
				.min=0;
				.max=ListBGMask.height-ListBG.height;
				.pos = 0;
				.visible = true;
				.mastar = this;
				//.RClickFunc=RCliclEvent;
				.PlaySe = function(file){};
				.onMovement = function(s_pos,value)
				{
					ListBG.top = value;

					/*btnUp.enabled = btnUpNext.enabled = btnDown.enabled = btnDownNext.enabled = true;

					if(value == Slid.min)
						btnUp.enabled = btnUpNext.enabled = false;
					else if(value == Slid.max)
						btnDown.enabled = btnDownNext.enabled = false;*/
				}incontextof this;
			}
		}
	}
}

class WF_ButtonLayerSwitch extends WF_ButtonLayer
{
	var _select = false;

	property select
	{
		setter(v)
		{
			_select = v;
			drawState(0);
		}
		getter
		{
			return _select;
		}
	}

	function WF_ButtonLayerSwitch(f_window,f_parent,f_Segment=6,f_SEFlag=true)
	{
		super.WF_ButtonLayer(f_window,f_parent,f_Segment,f_SEFlag);
	}

	function onMouseUp(x, y, button, shift)
	{
		if( button == mbLeft )
		{
			select = !select;
		}

		super.onMouseUp(...);
	}

	function drawState(s)
	{
		if(!enabled)
		{
			if(Segment == 4 || Segment == 5)
				s = 3; // �������
			else
				s = 2;
		}
		else if(_select)
		{
			if(Segment == 6) // 6�A�{�^���������ꍇ
			{
				if(s == 2)
					s=5;
				else if(s != 1)
					s=4;
			}
			else if(Segment == 5)
			{
				s = 4;
			}
			else
			{
				s = 3;
			}
		}

		imageLeft = -s * width if ImageFileName !== void;
	}
}

class WF_ButtonLayer extends ButtonLayer
{
	var ImageFileName = void;
	var Segment = 5;
	var window;
	var _isSelecting = false;
	var seEnterFilename = "SE_001";
	var seCancelFilename = "";//"SE_002";
	var seSelectFilename = "SE_003";

	var SoundPlayFlag = false;

	var CursorType_Default = crDefault;
	var CursorType_Point = crDefault;//crHandPoint;

	// �Œ蕝�ŕ�����`�悷�邩�ǂ���
	var TextFix=false;
	// ���s�ɗp���镶��
	var LineChara = '|';
	var _RegLineChara = /\|/g; // ���K�\���p
	// ���s������\n��L���ɂ��邩�ǂ����B�����ɂ����ꍇ\n�͎�菜�����
	var LineCode=false;

	// �e�L�X�g�̌`�� left or center or right
	var texttypeX = "left";
	// �e�L�X�g�̌`�� top or center
	var texttypeY = "top";
	// �e�L�X�g�`��̈�̕����w�肷��
	var TR_height=0;
	var TR_width=0;

	// ���s���̃I�t�Z�b�gY��
	var newlineoffset_y=0;

	var Font="���C���I";

	// �N���b�N���L����������
	// false�Ȃ�onMouseEnterEx��onMouseLeaveEx,RClickEvent�̂ݔ���
	// �J�[�\�����킳��������SE�Đ��͂���Ȃ��̂Œ���
	var _clickEnabled=true;
	var selectSEPlayFlag=true;

	property clickEnabled
	{
		setter(v)
		{
			_clickEnabled = selectSEPlayFlag = v;
		}
		getter()
		{
			return _clickEnabled;
		}
	}


	function finalize(){ super.finalize(...); }

	function WF_ButtonLayer(f_window,f_parent,f_Segment=5,f_SEFlag=true)
	{
		super.ButtonLayer(f_window,f_parent);
		this.window = f_window;
		Segment = f_Segment;
		if( (typeof this.window.SoundMGR) == 'undefined')
			SoundPlayFlag = false;
		else
			SoundPlayFlag = f_SEFlag;
	}

	if( typeof(global.CherryAINormalizeNonMessageText) == "undefined" )
	{
		global.CherryAINormalizeNonMessageText = function(f_Text,f_LineCode,f_LineChara)
		{
			var Text = "" + f_Text;
			Text = Text.replace(/\r\n/g,"\n");
			Text = Text.replace(/\r/g,"\n");
			if(Text.indexOf("\n") != -1)
			{
				if(f_LineCode)
					Text = Text.replace(/\n/g,f_LineChara);
				else
					Text = Text.replace(/\n/g,'');
			}
			return Text;
		};

		global.CherryAIIsNonMessageWhitespace = function(f_Char)
		{
			return f_Char == " " || f_Char == "\t" || f_Char == "\u3000" || f_Char == "\u00A0";
		};

		global.CherryAIIsNonMessagePunctuationBreak = function(f_Char)
		{
			if(f_Char === void || f_Char == "")
				return false;
			return ".,!?;:，。！？；：)]}」』）\u201D'\"".indexOf(f_Char) != -1;
		};

		global.CherryAIIsNonMessageAsciiMetricsChar = function(f_Char)
		{
			if(f_Char === void || f_Char == "")
				return false;
			return " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~".indexOf(f_Char) != -1;
		};

		global.CherryAIGetNonMessageWhitespaceAdvance = function(f_Lay,f_Char,f_Prefix="",f_NextChar=void)
		{
			var SpaceWidth = 0;
			var MinimumSpaceWidth = (f_Lay.font.height * 3) >> 3;
			var ShadowWidth = 0;
			if(typeof(f_Lay.font.type_shadowwidth) != "undefined" && 0 < f_Lay.font.type_shadowwidth)
				ShadowWidth = f_Lay.font.type_shadowwidth;
			MinimumSpaceWidth += ShadowWidth;
			if(f_NextChar !== void && f_NextChar != "" && f_NextChar != "|" && f_NextChar != "\n")
			{
				var WithSpace = f_Lay.font.getTextWidth(f_Prefix + f_Char + f_NextChar);
				var WithoutSpace = f_Lay.font.getTextWidth(f_Prefix + f_NextChar);
				SpaceWidth = WithSpace - WithoutSpace;
			}
			if(SpaceWidth < 1)
				SpaceWidth = f_Lay.font.getTextWidth("A A") - f_Lay.font.getTextWidth("AA");
			if(SpaceWidth < 1)
				SpaceWidth = f_Lay.font.getTextWidth("m m") - f_Lay.font.getTextWidth("mm");
			if(SpaceWidth < 1)
				SpaceWidth = MinimumSpaceWidth;
			if(SpaceWidth < MinimumSpaceWidth)
				SpaceWidth = MinimumSpaceWidth;
			if(SpaceWidth < 1)
				SpaceWidth = 1;
			if(f_Char == "\t")
				return SpaceWidth * 4;
			return SpaceWidth;
		};

		global.CherryAIGetNonMessageCharAdvance = function(f_Lay,f_Char,f_Prefix="",f_NextChar=void)
		{
			if(global.CherryAIIsNonMessageWhitespace(f_Char))
				return global.CherryAIGetNonMessageWhitespaceAdvance(f_Lay,f_Char,f_Prefix,f_NextChar);

			var CharWidth = 0;
			if(f_NextChar !== void && f_NextChar != "" && f_NextChar != "|" && f_NextChar != "\n")
			{
				var WithChar = f_Lay.font.getTextWidth(f_Prefix + f_Char + f_NextChar);
				var WithoutChar = f_Lay.font.getTextWidth(f_Prefix + f_NextChar);
				CharWidth = WithChar - WithoutChar;
			}
			if(CharWidth < 1)
			{
				var WithCharOnly = f_Lay.font.getTextWidth(f_Prefix + f_Char);
				var WithoutCharOnly = 0;
				if(f_Prefix != "")
					WithoutCharOnly = f_Lay.font.getTextWidth(f_Prefix);
				CharWidth = WithCharOnly - WithoutCharOnly;
			}

			var TextWidth = f_Lay.font.getTextWidth(f_Char);
			var EscWidth = f_Lay.font.getEscWidthX(f_Char);
			if(CharWidth < 1)
				CharWidth = TextWidth;
			if(CharWidth < 1)
				CharWidth = EscWidth;
			if(CharWidth < 1)
				CharWidth = 1;

			if(!global.CherryAIIsNonMessageAsciiMetricsChar(f_Char))
			{
				if(0 < TextWidth && TextWidth < CharWidth)
					CharWidth = TextWidth;
				if(0 < EscWidth && EscWidth < CharWidth)
					CharWidth = EscWidth;
			}

			if(CharWidth < 1)
				CharWidth = 1;
			return CharWidth;
		};

		global.CherryAIUseNonMessageFixedCell = function(f_Lay,f_Char,f_CharAdvance=void,f_TextFix=false)
		{
			if(!f_TextFix)
				return false;
			if(global.CherryAIIsNonMessageAsciiMetricsChar(f_Char))
				return false;
			if(f_CharAdvance === void)
				f_CharAdvance = global.CherryAIGetNonMessageCharAdvance(f_Lay,f_Char);
			return f_CharAdvance * 4 >= f_Lay.font.height * 3;
		};

		global.CherryAIGetNonMessageCharRectWidth = function(f_Lay,f_Char,f_CharAdvance=void,f_UseFixedCell=false)
		{
			if(f_CharAdvance === void)
				f_CharAdvance = global.CherryAIGetNonMessageCharAdvance(f_Lay,f_Char);
			if(f_UseFixedCell)
				return f_Lay.font.height;
			var GlyphWidth = f_Lay.font.getTextWidth(f_Char);
			if(GlyphWidth < 1)
				GlyphWidth = f_Lay.font.getEscWidthX(f_Char);
			if(GlyphWidth < 1)
				GlyphWidth = f_CharAdvance;
			if(GlyphWidth < 1)
				GlyphWidth = 1;
			return GlyphWidth;
		};

		global.CherryAIBuildNonMessageWrapStarts = function(f_Lay,f_Text,f_MaxWidth,f_LineChara)
		{
			var WrapStarts = new Array();
			if(f_MaxWidth < 1)
				return WrapStarts;
			var LineText = "";
			var LastBreakPos = -1;
			var cnt = f_Text.length;
			for(var Pos = 0; Pos < cnt; Pos++)
			{
				var Ch = f_Text.charAt(Pos);
				if(Ch == f_LineChara)
				{
					LineText = "";
					LastBreakPos = -1;
					continue;
				}
				var CandidateLineText = LineText + Ch;
				var CandidateWidth = f_Lay.font.getTextWidth(CandidateLineText);
				if(0 < LineText.length && f_MaxWidth < CandidateWidth)
				{
					if(0 <= LastBreakPos)
					{
						WrapStarts[LastBreakPos + 1] = true;
						Pos = LastBreakPos;
					}
					else
					{
						WrapStarts[Pos] = true;
						Pos--;
					}
					LineText = "";
					LastBreakPos = -1;
					continue;
				}
				LineText = CandidateLineText;
				if(global.CherryAIIsNonMessageWhitespace(Ch) || global.CherryAIIsNonMessagePunctuationBreak(Ch))
					LastBreakPos = Pos;
			}
			for(var WrapPos = 0; WrapPos < cnt; WrapPos++)
			{
				if(!WrapStarts[WrapPos])
					continue;
				var WrapChar = f_Text.charAt(WrapPos);
				if(global.CherryAIIsNonMessageWhitespace(WrapChar) || global.CherryAIIsNonMessagePunctuationBreak(WrapChar))
				{
					var Forward = WrapPos + 1;
					while(Forward < cnt)
					{
						var ForwardChar = f_Text.charAt(Forward);
						if(ForwardChar == f_LineChara)
							break;
						if(!global.CherryAIIsNonMessageWhitespace(ForwardChar) && !global.CherryAIIsNonMessagePunctuationBreak(ForwardChar))
							break;
						Forward++;
					}
					if(Forward < cnt && f_Text.charAt(Forward) != f_LineChara && !WrapStarts[Forward])
					{
						WrapStarts[WrapPos] = false;
						WrapStarts[Forward] = true;
					}
				}
			}
			return WrapStarts;
		};

		global.CherryAIBuildNonMessageLayout = function(f_Lay,f_Text,f_MaxWidth,f_LineChara,f_TextFix=false)
		{
			var Layout = %[];
			Layout.rects = new Array();
			Layout.line_widths = new Array();
			Layout.line_count = 0;
			if(f_Text === void || f_Text == "")
				return Layout;
			var WrapStarts = global.CherryAIBuildNonMessageWrapStarts(f_Lay,f_Text,f_MaxWidth,f_LineChara);
			var cnt = f_Text.length;
			var FontHeight = f_Lay.font.height;
			if(FontHeight <= 0)
				FontHeight = f_Lay.font.getEscHeightY(" ");
			if(FontHeight <= 0)
				FontHeight = 1;
			var LineIndex = 0;
			var LineWidth = 0;
			var LineText = "";
			for(var Pos = 0; Pos < cnt; Pos++)
			{
				var Ch = f_Text.charAt(Pos);
				if(Ch == f_LineChara)
				{
					Layout.line_widths[LineIndex] = LineWidth;
					LineIndex++;
					LineWidth = 0;
					LineText = "";
					continue;
				}
				if(WrapStarts[Pos] && 0 < LineWidth)
				{
					Layout.line_widths[LineIndex] = LineWidth;
					LineIndex++;
					LineWidth = 0;
					LineText = "";
				}
				if(LineWidth == 0 && LineText == "" && global.CherryAIIsNonMessageWhitespace(Ch))
					continue;
				var NextChar = void;
				if(Pos + 1 < cnt)
					NextChar = f_Text.charAt(Pos + 1);
				var CharAdvance = global.CherryAIGetNonMessageCharAdvance(f_Lay,Ch,LineText,NextChar);
				var UseFixedCell = global.CherryAIUseNonMessageFixedCell(f_Lay,Ch,CharAdvance,f_TextFix);
				var CellWidth = global.CherryAIGetNonMessageCharRectWidth(f_Lay,Ch,CharAdvance,UseFixedCell);
				if(UseFixedCell)
					CharAdvance = FontHeight;
				var Margin = 0;
				if(UseFixedCell)
				{
					var GlyphWidth = f_Lay.font.getEscWidthX(Ch);
					if(GlyphWidth < 0)
						GlyphWidth = 0;
					Margin = (FontHeight - GlyphWidth) >> 1;
					if(Margin < 0)
						Margin = 0;
				}
				var Rect = %[];
				Rect["left"] = LineWidth;
				Rect["top"] = LineIndex * FontHeight;
				Rect["advance"] = CharAdvance;
				Rect["width"] = CellWidth;
				Rect["margin"] = Margin;
				Rect["line"] = LineIndex;
				Rect["char"] = Ch;
				Layout.rects.add(Rect);
				LineWidth += CharAdvance;
				LineText += Ch;
			}
			Layout.line_widths[LineIndex] = LineWidth;
			Layout.line_count = LineIndex + 1;
			return Layout;
		};
	}

	// SE�̍Đ�
	function PlaySe(file)
	{
		if(file == "" && file !== void) return;
		if( SoundPlayFlag )
			this.window.SoundMGR.PlaySYSTEMSE(file);
	}

	function drawState(s)
	{
		if( ImageFileName === void ) return;

		if( !enabled || !clickEnabled )
		{
			if(Segment == 4 || Segment == 5)
				s = 3; // �������
			else
				s = 2;
			if(isSelecting)
				s=4;
		}
		else if(isSelecting)
		{
			if(Segment == 5)
				s = 4;
			else
				s = 3;
		}

		imageLeft = -s * width;
		onDrawState(s);
	}

	// �C�x���g
	function onDrawState(s){}

	function assignComp(src)
	{
		super.assign(src);
		ImageFileName = src.ImageFileName;
		callOnPaint = true;
	}

	function loadImages(storage, key)
	{
		// �摜��ǂݍ���
		global.Layer.loadImages(storage, key);
		global.Layer.width = imageWidth \ Segment;
		global.Layer.height = imageHeight;
		ImageFileName = storage;
		callOnPaint = true;
		Butt_imageLoaded = true;
	}

	function onMouseDown(x, y, button, shift)
	{
		if( !_checkallenabled() )
		{
			onDownReset();
			return;
		}

		if( clickEnabled == true )
		{
			super.onMouseDown(...);

			// �I����������
			if(isSelecting)	cursor = CursorType_Default;
		}
		else
		{
			// RClick�C�x���g��������������
			if( !Butt_mouseDownLFlag ) return;
			onDownReset();
			if(button == mbRight)
			{
				if(RClickFunc !== void )
				{
					onCallRFunc(RClickFuncArgs);
					return;
				}
			}
		}
	}

	function onMouseEnter()
	{
		if( enabled == true )
		{
			if(isSelecting)
				cursor = CursorType_Default;
			else
				cursor = CursorType_Point;

			if(selectSEPlayFlag)
				PlaySe(seSelectFilename);

			super.onMouseEnter();
		}
	}

	function onMouseLeave()
	{
		cursor = CursorType_Default;
		super.onMouseLeave();
	}

	function onMouseUpExPrev()
	{
		PlaySe(seEnterFilename);
	}
	function RClickFuncPrev()
	{
		PlaySe(seCancelFilename);
	}

	function drawTextEx(x,y,str,color=0x000000,opa=255, aa=true, shadowlevel=0, shadowcolor=0x000000, shadowwidth=0, shadowofsx=0, shadowofsy=0)
	{
		if(ImageFileName == void || ImageFileName == "")
		{
			_drawTextEx(...);
		}
		else
		{
			for(var i=0; i < Segment;i++)
				_drawTextEx(x+i*imageWidth\Segment,y,str,color,opa, aa, shadowlevel, shadowcolor, shadowwidth, shadowofsx, shadowofsy);
		}
	}

	function _drawTextEx(x,y,str,color=0x000000,opa=255, aa=true, shadowlevel=0, shadowcolor=0x000000, shadowwidth=0, shadowofsx=0, shadowofsy=0)
	{
		if( str === void || str== "" ) return;
		TR_height = this.height if TR_height == 0;
		TR_width = this.width if TR_width == 0;
		str = global.CherryAINormalizeNonMessageText(str,LineCode,LineChara);
		var Layout = global.CherryAIBuildNonMessageLayout(this,str,TR_width,LineChara,TextFix);
		if(Layout.line_count < 1)
			return;
		var FontHeight = font.height;
		if( FontHeight <= 0 )
			FontHeight = font.getEscHeightY(" ");
		if( FontHeight <= 0 )
			FontHeight = 1;

		var mPy=0;
		if(texttypeY == "center" )
		{
			var strheight = Layout.line_count * FontHeight;
			mPy = (TR_height>>1)-(strheight>>1);
		}

		for(var i=0; i < Layout.rects.count;i++)
		{
			var Rect = Layout.rects[i];
			var LineWidth = Layout.line_widths[Rect["line"]];
			if(LineWidth === void)
				LineWidth = 0;
			var LineOffsetX = 0;
			if(texttypeX == "center")
				LineOffsetX = (TR_width>>1) - (LineWidth>>1);
			else if(texttypeX == "right")
				LineOffsetX = TR_width - LineWidth;

			drawText(Rect["left"] + Rect["margin"] + LineOffsetX + x, Rect["top"] + mPy + y + Rect["line"]*newlineoffset_y, Rect["char"], color
						,opa, aa, shadowlevel, shadowcolor, shadowwidth, shadowofsx, shadowofsy);
		}
	}


	property isSelecting
	{
		setter(x)
		{
			_isSelecting = x;
			cursor = CursorType_Default;
			drawState(0);
		}
		getter
		{
			return _isSelecting;
		}
	}

	property enabled
	{
		setter(v)
		{
			super.enabled = v;
			hitThreshold = v ? 0 : 256;
			cursor = CursorType_Default if !v;

			if(!v)
			{
				Butt_mouseDown = false;
				Butt_mouseDownRFlag = Butt_mouseDownLFlag =false;
			}

			drawState(0);
		}
		getter
		{
			return super.enabled;
		}
	}


}

// WF_Layer�Ή���
class ButtonLayer extends WF_Layer
{
	var Butt_imageLoaded = false; // �摜���ǂݍ��܂ꂽ��
	var Butt_mouseOn = false; // ���C�����Ƀ}�E�X�����邩
	var Butt_mouseDown = false; // �}�E�X�{�^����������Ă��邩
	var Butt_color = clNone;
	var Butt_caption = ''; // �{�^���̃L���v�V����
	var Butt_captionColor = 0x000000; // �L���v�V�����̐F
	var Butt_keyPressed = false;
	var Butt_showFocusImage = false;

	var Butt_mouseDownRFlag = false;
	var Butt_mouseDownLFlag = false;

	function ButtonLayer(win, par)
	{
		super.WF_Layer(win, par);

		hitType = htMask;
		hitThreshold = 0;
		//focusable = true; // �t�H�[�J�X�𓾂���
	}

	function finalize()
	{
		super.finalize(...);
	}

	function assign(src)
	{
		// src �̏������̃{�^�����C���ɃR�s�[
		assignImages(src);
		Butt_imageLoaded = src.Butt_imageLoaded;
		Butt_color = src.Butt_color;
		Butt_caption = src.Butt_caption;
		Butt_captionColor = src.Butt_captionColor;
		hitThreshold = src.hitThreshold;
		super.width = src.width;
		super.height = src.height;
		imageWidth = src.imageWidth;
		imageHeight = src.imageHeight;
		update();
	}

	function drawState(s)
	{
		// ��� s �ɑΉ�����摜��`��
		// s :  0 : ���ʂ̏��
		//      1 : �{�^���������ꂽ���
		//      2 : �{�^���̏�Ƀ}�E�X�J�[�\����������
		//     (3): �t�H�[�J�X������ꍇ
		if(!enabled)
		{
			s = 0; // �������
		}

		if(Butt_imageLoaded)
		{
			// �{�^���C���[�W���ǂݍ��܂�Ă���
			// TODO: keyboard focus
			imageLeft = -s * width;
		}
		else
		{
			if(Butt_keyPressed) s = 1; // ������Ă���

			// �g�ƃL���v�V������`��
			// �N���A
			face = dfAlpha;
			colorRect(0, 0, width, height, 0, -255);
			// ���n��h��
			if(Butt_color != clNone)
				colorRect(0, 0, width, height, Butt_color, 128);
			// �����̃T�C�Y�𓾂�
			var tw, th;
			tw = font.getTextWidth(Butt_caption);
			th = font.getTextHeight(Butt_caption);
			if(s == 0 || s == 2)
			{
				// �ʏ킠�邢�̓}�E�X����ɂ���
				colorRect(0, 0, width, 1, 0xffffff, 128);
				colorRect(0, 1, 1, height-2, 0xffffff, 128);
				colorRect(width-1, 1, 1, height-1, 0x000000, 128);
				colorRect(1, height-1, width-2, 1, 0x000000, 128);
				drawText((width-tw)>>1, (height-th)>>1, 
					Butt_caption, Butt_captionColor, nodeEnabled?255:128);
			}
			else
			{
				// ������Ă���
				colorRect(0, 0, width, 1, 0x000000, 128);
				colorRect(0, 1, 1, height-2, 0x000000, 128);
				colorRect(width-1, 1, 1, height-1, 0xffffff, 128);
				colorRect(1, height-1, width-2, 1, 0xffffff, 128);
				drawText(((width-tw)>>1) +1, ((height-th)>>1) +1, 
					Butt_caption, Butt_captionColor, nodeEnabled?255:128);
			}

			if(s != 0)
				colorRect(2, 2, width-4, height-4, clHighlight, 64); // �n�C���C�g����

			if(focused)
			{
				// �t�H�[�J�X������̂Ńn�C���C�g����
				colorRect(2, 2, width-4, 1, clHighlight, 128);
				colorRect(2, 3, 1, height-5, clHighlight, 128);
				colorRect(3, height-3, width-5, 1, clHighlight, 128);
				colorRect(width-3, 3, 1, height-6, clHighlight, 128);
			}
		}
	}

	function loadImages(storage, key)
	{
		// �摜��ǂݍ���
		super.loadImages(storage, key);
		super.width = imageWidth \ (Butt_showFocusImage ? 4 : 3);
		super.height = imageHeight;
		callOnPaint = true;
		Butt_imageLoaded = true;
	}

	function discardImage()
	{
		// �摜��j�����A�����{�^�����C���Ƃ��ē��삷��悤�ɂ���
		Butt_imageLoaded = false;
		imageLeft = imageTop = 0;
		update();
	}

	function onExecute(x, y, button, shift)
	{
		// �}�E�X�{�^����������āA�����ꂽ�Ƃ��ɌĂ΂��
		// �������̃{�^���������ꂽ���Ƃɂ��R�}���h�Ȃǂ������������ꍇ��
		// onMouseUp �� onClick ���I�[�o�[���C�h�������
		// ���̃��\�b�h���I�[�o�[���C�h���邱�Ƃ𐄏�����
	}

	function onDownReset()
	{
		releaseCapture();
		Butt_mouseDown = false;
		Butt_mouseDownRFlag = Butt_mouseDownLFlag =false;
		//focus();
		update();
		cursor = crDefault;
	}

	function onMouseDown(x, y, button, shift)
	{
		if( !_checkallenabled() )
		{
			onDownReset();
			return;
		}

		// onMouseDown �C�x���g�n���h��
		if( Butt_mouseDownLFlag || Butt_mouseDownRFlag )
		{
			onDownReset();
			return;
		}
		else
		{
			if( button == mbLeft && getKeyState(VK_RBUTTON))
			{
				onDownReset();
				return;
			}
			else if(button == mbRight && getKeyState(VK_LBUTTON) )
			{
				onDownReset();
				return;
			}
		}

		Butt_mouseDownLFlag = Butt_mouseDownRFlag = false;

		if( button == mbLeft)
		{
			// onMouseDown �C�x���g�n���h��
			Butt_mouseDownLFlag = true;
			Butt_mouseDown = true;
			if(!Butt_mouseDownRFlag)
			{
				onMouseDownExPrev();
				onMouseDownEx(...);
			}
			focus();
			update();
		}
		else if(button == mbRight)
		{
			if(RClickFunc !== void )
			{
				onCallRFunc();
				return;
			}

			Butt_mouseDownRFlag = true;
			if(!Butt_mouseDownLFlag)
				onMouseDownEx(...);
			focus();
			update();
		}
		//super.onMouseDown(...);
	}

	function onMouseUp(x, y, button, shift)
	{
		if( !_checkallenabled() )
		{
			onDownReset();
			return;
		}

		if( button == mbLeft )
		{
			// onMouseUp �C�x���g�n���h��
			if(Butt_mouseDown)
			{
				onExecute(...);
			}
			// �ǉ��̃C�x���g
			if(Butt_mouseDownLFlag && !Butt_mouseDownRFlag && Butt_mouseDown)
			{
				if(enabled)
				{
					onMouseUpExPrev();
					onMouseUpEx(...);
				}
			}
			Butt_mouseDownLFlag = false;
			Butt_mouseDown = false;
		}
		else if( button == mbRight )
		{
			// �ǉ��̃C�x���g
			if(Butt_mouseDownRFlag && !Butt_mouseDownLFlag)
			{
				if(enabled)
					onMouseUpEx(...);
			}
			Butt_mouseDownRFlag = false;
		}

		update();
		//super.onMouseUp(...);
	}

	function onClick()
	{
		// onClick �C�x���g�n���h��
		super.onClick(...);
	}

	function draw()
	{
		// ���݂̏�Ԃɂ��킹�ĕ`����s��
		if(Butt_mouseDown) drawState(1);
		else if(Butt_mouseOn) drawState(2);
		else if(Butt_showFocusImage && focused) drawState(3);
		else drawState(0);
	}

	function onPaint()
	{
		// �`��̒��O�ɌĂ΂��
		super.onPaint(...);
		draw();
	}

	// onMouseDownEx or Down���Ă΂�鐡�O�ɌĂ΂��C�x���g
	function onMouseUpExPrev(){}
	function onMouseDownExPrev(){}
	function RClickFuncPrev(){} // RClickFunc�O�ɌĂ΂��C�x���g

	function onMouseEnter()
	{
		// �}�E�X�����C���̈���ɓ�����
		update();
		Butt_mouseOn = true;

		if( Butt_mouseDownLFlag || Butt_mouseDownRFlag )
		{
			Butt_mouseDownLFlag = Butt_mouseDownRFlag = false;
		}

		super.onMouseEnter(...);
	}

	function onMouseLeave()
	{
		// �}�E�X�����C���̈悩��o�Ă�����
		update();
		Butt_mouseOn = false;
		Butt_mouseDown = false;
		super.onMouseLeave(...);
	}

	function onNodeDisabled()
	{
		// ���C���̃m�[�h���s�ɂȂ���
		super.onNodeDisabled(...);
		Butt_mouseDown = false;
		update();
	}

	function onNodeEnabled()
	{
		// ���C���̃m�[�h���L���ɂȂ���
		super.onNodeEnabled(...);
		update();
	}

	function onFocus()
	{
		// �t�H�[�J�X�𓾂�
		super.onFocus(...);
		update();
	}

	function onBlur()
	{
		// �t�H�[�J�X��������
		super.onBlur(...);
		Butt_mouseDown = false;
		update();
	}

	function onKeyDown(key, shift, process)
	{
		if( !_checkallenabled() )
			return;
		// �L�[�������ꂽ
		if(process)
		{
			if(key == VK_RETURN || key == VK_SPACE)
			{
				// �X�y�[�X�L�[�܂��̓G���^�[�L�[
				Butt_keyPressed = true;
				update();
				super.onKeyDown(key, shift, false); // �����������̂�process��false��n��
			}
			else
			{
				super.onKeyDown(...);
			}
		}
		else
		{
			// process �� false �̏ꍇ�͏����͍s��Ȃ�
			super.onKeyDown(...);
		}
	}

	function onKeyUp(key, shift, process)
	{
		if( !_checkallenabled() )
			return;
		// �L�[�������ꂽ
		if(process)
		{
			if(key == VK_RETURN || key == VK_SPACE)
			{
				// �X�y�[�X�L�[�܂��̓G���^�[�L�[
				var flag = Butt_keyPressed;
				Butt_keyPressed = false;
				update();
				super.onKeyUp(key, shift, false);
				if(flag) onClick(width \ 2, height \ 2); // �N���b�N����
			}
			else
			{
				super.onKeyUp(...);
			}
		}
		else
		{
			super.onKeyUp(...);
		}
	}

	function onKeyPress(key, shift)
	{
		super.onKeyPress(...);
	}


	property width
	{
		setter(x)
		{
			super.width = x;
			imageWidth = x;
			Butt_imageLoaded = false;
			update();
		}
		getter
		{
			return super.width;
		}
	}

	property height
	{
		setter(x)
		{
			super.height = x;
			imageHeight = x;
			Butt_imageLoaded = false;
			update();
		}
		getter
		{
			return super.height;
		}
	}

	function setSize(w, h)
	{
		super.setSize(w, h);
		w = this.width;
		h = this.height;
		setImageSize(w, h);
		Butt_imageLoaded = false;
		update();
	}

	property caption
	{
		setter(x)
		{
			Butt_caption = x;
			update();
		}
		getter
		{
			return Butt_caption;
		}
	}

	property color
	{
		setter(x)
		{
			Butt_color = int x;
			update();
		}
		getter
		{
			return Butt_color;
		}
	}

	property captionColor
	{
		setter(x)
		{
			Butt_captionColor = int x;
			update();
		}
		getter
		{
			return Butt_captionColor;
		}
	}

	property showFocusImage
	{
		setter(x) { Butt_showFocusImage = x; }
		getter { return Butt_showFocusImage; }
	}
}
