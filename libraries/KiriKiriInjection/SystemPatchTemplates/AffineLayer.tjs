
class cAnimeTimer
{
	var layer=void;
	var dataFile=void;
	var contimer=void;

	var AnimeData=void;
	var FrameName="";
	var SegmentPx=void;
	var SegmentPy=void;

	function finalize()
	{
		invalidate contimer;
	}

	function cAnimeTimer(f_layer)
	{
		layer = f_layer;
		contimer = new Continuous(onTimer);
		contimer.interval = 1;
		contimer.capacity = 1;
		contimer.enabled = false;
		contimer.calltime = void;
		contimer.waittime = 0;
	}

	function clear()
	{
		dataFile = void;
		FrameName = "first";
		contimer.enabled = false;
		AnimeData = void;
		layer.setImagePos(0,0);
	}

	// Set���Ă΂�Ă��鎖���O��
	function Init()
	{
		if( dataFile === void ) return;

		Set(dataFile);
	}

	function Set(f_file=void)
	{
		if( f_file === void || f_file == "" ) return;

		if( f_file.indexOf(".") == -1 )
			dataFile = f_file+".txt";
		else
			dataFile = f_file;

		AnimeData = Scripts.evalStorage(dataFile);
		SegmentPx = AnimeData["SizeX"];
		SegmentPy = AnimeData["SizeY"];
		AnimeData = AnimeData["Data"];

		layer.setSize(SegmentPx,SegmentPy);
		layer.setImagePos(0,0);

		FrameName = "first";
		contimer.enabled = false;
	}

	function Start()
	{
		if( dataFile === void ) return;

		setImage();
		contimer.enabled = true;
		contimer.waittime = AnimeData[FrameName]["WaitTime"];
		contimer.calltime = System.getTime();
	}

	function Stop()
	{
		if( dataFile === void ) return;
		contimer.enabled = false;
		setImage();
		FrameName = "first";
	}

	function assignComp(src)
	{
		dataFile = src.dataFile;

		if( dataFile !== void )
		{
			if(AnimeData === void)
				AnimeData = %[];
			(Dictionary.assignStruct incontextof AnimeData)(src.AnimeData);
			SegmentPx = src.SegmentPx;
			SegmentPy = src.SegmentPy;
			FrameName = src.FrameName;
			contimer.enabled = src.contimer.enabled;
			contimer.calltime = src.contimer.calltime;
			contimer.waittime = src.contimer.waittime;
		}
	}

	function onTimer()
	{
		if( dataFile === void ) return;
		var tmp_taime = System.getTime();
		if( (tmp_taime - contimer.calltime) >= contimer.waittime)
		{
			contimer.waittime = AnimeData[FrameName]["WaitTime"];
			contimer.calltime = tmp_taime;
			setImage();
			onNextFrame();
			FrameName = AnimeData[FrameName]["Next"];
		}
	}

	function onNextFrame()
	{
	}

	function setImage(f_lay=void)
	{
		if( AnimeData === void || dataFile === void) return;

		if( f_lay === void )
			f_lay = this.layer;

		var Px = 0;
		var Py = 0;
		if( AnimeData[FrameName]["PosX"] !== void )
			Px = (SegmentPx*AnimeData[FrameName]["PosX"])*-1;
		if( AnimeData[FrameName]["PosY"] !== void )
			Py = (SegmentPy*AnimeData[FrameName]["PosY"])*-1;
		f_lay.setImagePos( Px, Py );
	}

	var _storedata_AnimeTime = new Dictionary();
	function store()
	{
		_storedata_AnimeTime["dataFile"] = dataFile;

		if( dataFile !== void )
		{
			_storedata_AnimeTime["FrameName"] = FrameName;
			_storedata_AnimeTime["StartFlag"] = contimer.enabled;
			_storedata_AnimeTime["SegmentPx"] = SegmentPx;
			_storedata_AnimeTime["SegmentPy"] = SegmentPy;
		}
		else
		{
			_storedata_AnimeTime["FrameName"] = _storedata_AnimeTime["StartFlag"] = _storedata_AnimeTime["SegmentPx"] = _storedata_AnimeTime["SegmentPy"] = void;
		}

		return _storedata_AnimeTime;
	}

	function restore(data)
	{
		clear();
		dataFile = data["dataFile"];
		if( dataFile !== void )
		{
			AnimeData = Scripts.evalStorage(dataFile);
			AnimeData = AnimeData["Data"];
			SegmentPx = data["SegmentPx"];
			SegmentPy = data["SegmentPy"];

			FrameName = data["FrameName"];
			if( data["StartFlag"] )
				Start();
		}
	}
}

class AnimeLayer extends WF_Layer
{

	var AnimeTimer;

	function finalize()
	{
		invalidate AnimeTimer;
		super.finalize();
	}

	function AnimeLayer(win,par)
	{
		super.WF_Layer(win,par);

		AnimeTimer = new cAnimeTimer(this);
	}

	function Start(){ AnimeTimer.Start(); }
	function Stop(){ AnimeTimer.Stop(); }

	function loadImages(image)
	{
		super.loadImages(image);

		AnimeTimer.Set(image);
	}
}

